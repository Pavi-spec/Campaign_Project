<?xml version="1.0" encoding="UTF-8"?>
<jcr:root
        xmlns:jcr="http://www.jcp.org/jcr/1.0"
        xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
        jcr:primaryType="nt:unstructured"
        jcr:title="Flower Item"
        sling:resourceType="cq/gui/components/authoring/dialog">

    <content
            jcr:primaryType="nt:unstructured"
            sling:resourceType="granite/ui/components/coral/foundation/container">

        <items jcr:primaryType="nt:unstructured">

            <tabs
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/tabs">

                <items jcr:primaryType="nt:unstructured">

                    <flowerDetails
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Flower Details"
                            sling:resourceType="granite/ui/components/coral/foundation/container">

                        <items jcr:primaryType="nt:unstructured">

                            <category
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Category"
                                    fieldDescription="Example: FLOWER COLLECTION"
                                    name="./category"
                                    value="FLOWER COLLECTION"/>

                            <title
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Flower Title"
                                    fieldDescription="Enter the flower name."
                                    name="./title"
                                    required="{Boolean}true"/>

                            <image
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                    fieldLabel="Flower Image"
                                    fieldDescription="Select the flower image from the DAM."
                                    name="./image"
                                    rootPath="/content/dam"
                                    required="{Boolean}true"/>

                            <description
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                    fieldLabel="Flower Description"
                                    fieldDescription="Enter a short description of the flower."
                                    name="./description"
                                    rows="{Long}3"/>

                            <flowerDate
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/datepicker"
                                    fieldLabel="Flower Date"
                                    fieldDescription="Select the flower article date."
                                    name="./flowerDate"
                                    type="date"
                                    displayedFormat="DD MMMM YYYY"
                                    valueFormat="YYYY-MM-DD"
                                    required="{Boolean}false"/>

                            <readingTime
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Reading Time"
                                    fieldDescription="Optional. Example: 10 minutes."
                                    name="./readingTime"
                                    emptyText="10 minutes"/>

                            <articleLink
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                    fieldLabel="Button Destination Page"
                                    fieldDescription="Select the page that opens when the image button is clicked."
                                    name="./articleLink"
                                    rootPath="/content/drive"
                                    forceSelection="{Boolean}true"/>

                            <linkText
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Button Text"
                                    fieldDescription="Enter the text displayed inside the image button."
                                    name="./linkText"
                                    emptyText="Explore Flowers"/>

                            <descriptionLink
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                    fieldLabel="Description Destination Page"
                                    fieldDescription="Select the separate page that opens when the description is clicked."
                                    name="./descriptionLink"
                                    rootPath="/content/drive"
                                    forceSelection="{Boolean}true"/>

                        </items>
                    </flowerDetails>

                </items>
            </tabs>

        </items>
    </content>
</jcr:root>
