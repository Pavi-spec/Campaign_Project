<?xml version="1.0" encoding="UTF-8"?>
<jcr:root
        xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
        xmlns:jcr="http://www.jcp.org/jcr/1.0"
        xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
        jcr:primaryType="cq:Dialog"
        jcr:title="Company Directory"
        sling:resourceType="cq/gui/components/authoring/dialog">

    <content
            jcr:primaryType="nt:unstructured"
            sling:resourceType="granite/ui/components/coral/foundation/container">

        <items jcr:primaryType="nt:unstructured">

            <companyName
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                    fieldLabel="Company Name"
                    name="./companyName"
                    required="{Boolean}true"/>

            <description
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                    fieldLabel="Description"
                    name="./description"/>

            <location
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                    fieldLabel="Location"
                    name="./location"/>

            <departments
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                    fieldLabel="Departments"
                    composite="{Boolean}true">

                <field
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        name="./departments">

                    <items jcr:primaryType="nt:unstructured">

                        <departmentName
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Department Name"
                                name="departmentName"
                                required="{Boolean}true"/>

                        <departmentHead
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Department Head"
                                name="departmentHead"/>

                        <departmentLocation
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Department Location"
                                name="departmentLocation"/>

                        <employees
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                fieldLabel="Employees"
                                composite="{Boolean}true">

                            <field
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                    name="employees">

                                <items jcr:primaryType="nt:unstructured">

                                    <employeeName
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="Employee Name"
                                            name="employeeName"
                                            validation="company-name"
                                            required="{Boolean}true"/>

                                    <email
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="Email"
                                            name="email"
                                            validation="company-email"
                                            required="{Boolean}true"/>

                                    <phone
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="Phone"
                                            name="phone"
                                            validation="company-phone"
                                            required="{Boolean}true"/>

                                    <designation
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="Designation"
                                            name="designation"
                                            validation="company-name"/>

                                    <experience
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                            fieldLabel="Experience (Years)"
                                            name="experience"
                                            validation="company-experience"
                                            min="0"
                                            step="1"/>

                                    <employeeImage
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                            fieldLabel="Employee Image"
                                            name="employeeImage"
                                            rootPath="/content/dam"/>

                                    <employeeLink
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                            fieldLabel="Employee Profile Link"
                                            name="employeeLink"
                                            rootPath="/content"/>

                                    <projects
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                            fieldLabel="Projects"
                                            composite="{Boolean}true">

                                        <field
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/container"
                                                name="projects">

                                            <items jcr:primaryType="nt:unstructured">

                                                <projectName
                                                        jcr:primaryType="nt:unstructured"
                                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                        fieldLabel="Project Name"
                                                        name="projectName"
                                                        required="{Boolean}true"/>

                                                <projectDescription
                                                        jcr:primaryType="nt:unstructured"
                                                        sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                        fieldLabel="Project Description"
                                                        name="projectDescription"/>

                                                <projectUrl
                                                        jcr:primaryType="nt:unstructured"
                                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                        fieldLabel="Project URL"
                                                        name="projectUrl"
                                                        rootPath="/content"/>

                                                <projectImage
                                                        jcr:primaryType="nt:unstructured"
                                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                        fieldLabel="Project Image"
                                                        name="projectImage"
                                                        rootPath="/content/dam"/>

                                            </items>

                                        </field>

                                    </projects>

                                </items>

                            </field>

                        </employees>

                    </items>

                </field>

            </departments>

        </items>

    </content>

</jcr:root>